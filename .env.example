# Application
NODE_ENV=production
PORT=3000
SITE_ORIGIN=https://your-domain.com

# Where estimate requests should arrive
CONTACT_TO_EMAIL=owner@example.com
CONTACT_FROM_EMAIL=Hunt Home Improvements <estimates@your-domain.com>
RESEND_API_KEY=re_replace_with_resend_key

# Cloudflare Turnstile (create a site for your production domain)
TURNSTILE_SITE_KEY=replace_with_public_site_key
TURNSTILE_SECRET_KEY=replace_with_secret_key
